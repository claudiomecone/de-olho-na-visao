    if(K>=k1&&K<=k2){sc+=18;why.push('Ceratometria '+K.toFixed(2).replace('.',',')+' K na faixa da curva base');}
    else if(Math.min(Math.abs(K-k1),Math.abs(K-k2))<=2)sc+=6; else hard=1;}
  else if(/Customizável|Excentricidade|curvas/i.test(p.cb)){sc+=12;why.push('Curva base customizável sob topografia');}
  else if(p.id==='ceratogel-esf'||p.id==='ceratogel-tor'){if(K>=44){sc+=18;why.push('Ceratometria íngreme compatível (CB 7,9 / 7,6 / 7,3 mm)');}else hard=1;}
  if(S.ectasia){if(['bf-k','bf-kmax-pro','soper','smart-lens','zenlens','zenrc','ceratogel-esf','ceratogel-tor','bf-tor-pos'].indexOf(p.id)>-1){sc+=30;why.push('Desenho dedicado a ectasia corneana');}else sc-=16;}
  if(S.intol){if(p.id==='ceratogel-esf'||p.id==='ceratogel-tor'){sc+=34;why.push('Gelatinosa para intolerância a RGP');}else if(isR)sc-=26;}
  if(S.postref){if(['bf-kmax-pro','smart-lens','bf-k','zenlens','zenrc'].indexOf(p.id)>-1){sc+=30;why.push('Geometria para córnea oblata pós-refrativa');}else sc-=12;}
  if(S.transp){if(['smart-lens','bf-kmax-pro','zenlens','zenrc','bf-k'].indexOf(p.id)>-1){sc+=30;why.push('Indicada para pós-transplante / anel intraestromal');}else sc-=12;}
  if(S.dmp){if(p.id==='bf-kmax-pro'){sc+=40;why.push('Indicação específica: degeneração marginal pelúcida');}else sc-=10;}
  if(S.pedia){if(p.id==='afacia'){sc+=48;why.push('Única linha para afacia pediátrica (Ø 10,5/12,5 mm, CB 7,3–7,9)');}else hard=1;}
  if(S.micro){if(p.id==='afacia'||p.id==='hidrosol'){sc+=32;why.push('Diâmetros reduzidos / customizáveis para anatomia pequena');}else sc-=10;}
  if(S.presb){if(p.id==='expert-prog'){sc+=44;why.push('Multifocal progressiva RGP para présbitas');}else if(/monovisão/i.test(p.grau)){sc+=14;why.push('Estratégia de monovisão disponível');}else sc-=6;}
  if(S.night){if(p.id==='crx'){sc+=52;why.push('Uso noturno exclusivo — ortoceratologia');}else hard=1;}
  if(S.estetic){if(p.c==='est'){sc+=42;why.push('Linha estética colorida');}else sc-=20;}else if(p.c==='est')sc-=14;
  if(S.uv&&/UV/.test(p.mat+p.n+p.sub)){sc+=16;why.push('Bloqueador UVA/UVB na matriz polimérica');}
  if(p.id==='crx'&&esf<-8)hard=1;
  if(age<=3&&S.pedia&&p.id==='afacia')sc+=10;
  if(age>=42&&S.presb&&p.id==='expert-prog')sc+=6;
  if(hard)sc-=60;
  return {s:Math.max(0,Math.min(100,Math.round(sc/1.35))),w:why};
}
function runSim(){
  var K=parseFloat($('#sK').value),esf=parseFloat($('#sEsf').value),cil=parseFloat($('#sCil').value),age=parseInt($('#sAge').value,10);
  $('#oK').textContent=K.toFixed(2).replace('.',',')+' D';
  $('#oEsf').textContent=(esf>0?'+':'')+esf.toFixed(2).replace('.',',')+' D';
  $('#oCil').textContent=cil.toFixed(2).replace('.',',')+' D';
  $('#oAge').textContent=age+(age===1?' ano':' anos');
  ['sK','sEsf','sCil','sAge'].forEach(function(id){var e=document.getElementById(id);e.style.setProperty('--p',((e.value-e.min)/(e.max-e.min)*100)+'%');});
  var res=[];
  P.forEach(function(p){var r=evalLine(p,K,esf,cil,age);if(r.s>14)res.push({p:p,s:r.s,w:r.w});});
  res.sort(function(a,b){return b.s-a.s;});res=res.slice(0,6);
  $('#simCount').textContent=res.length?res.length+' linha(s) compatível(eis)':'nenhuma compatível';
  if(!res.length){$('#simOut').innerHTML='<div class="card pad" style="text-align:center;color:var(--mut2);font-size:14px;border-style:dashed">Nenhuma linha do portfólio atende simultaneamente a todos os parâmetros informados. Reveja as condições clínicas ou amplie a preferência de material.</div>';return;}
  $('#simOut').innerHTML=res.map(function(r){
    var cc=CATS[r.p.c].color;
    return '<div class="rec" data-p="'+r.p.id+'" style="border-left:3px solid '+cc+'">'+
     '<div class="rh"><h5>'+r.p.n+'</h5><span class="mt2" style="color:'+cc+'">'+r.s+'%</span></div>'+
     '<div class="mtr"><i style="width:'+r.s+'%;background:linear-gradient(90deg,'+cc+'77,'+cc+')"></i></div>'+
     '<p><span style="color:var(--mut2);font-weight:800;font-size:10.6px;letter-spacing:.1em;text-transform:uppercase">'+CATS[r.p.c].label+'</span> · '+r.p.mat+' · '+r.p.hid+' hidratação · Dk '+(r.p.dk===ND?'não localizado':r.p.dk)+'</p>'+
     '<div class="why">'+(r.w.length?r.w.map(function(x){return '<span>✓ '+x+'</span>';}).join(''):'<span>Compatibilidade genérica de grade</span>')+'</div></div>';}).join('');
  $$('#simOut .rec').forEach(function(e){e.onclick=function(){openP(this.getAttribute('data-p'));};});
}
safe(function(){
  $('#simToggles').innerHTML=SIMT.map(function(t){return '<button class="tg" data-t="'+t[0]+'"><span class="bx"></span>'+t[1]+'</button>';}).join('');
  $('#simMat').innerHTML=SIMM.map(function(m){return '<button class="tg on" data-m="'+m[0]+'"><span class="bx"></span>'+m[1]+'</button>';}).join('');
  $('#simToggles').addEventListener('click',function(e){var b=e.target.closest('.tg');if(!b)return;var k=b.getAttribute('data-t');S[k]=S[k]?0:1;b.classList.toggle('on',!!S[k]);runSim();});
  $('#simMat').addEventListener('click',function(e){var b=e.target.closest('.tg');if(!b)return;var k=b.getAttribute('data-m');M[k]=M[k]?0:1;b.classList.toggle('on',!!M[k]);runSim();});
  ['sK','sEsf','sCil','sAge'].forEach(function(id){document.getElementById(id).addEventListener('input',runSim);});
  $('#simReset').onclick=function(){$('#sK').value=44;$('#sEsf').value=-4;$('#sCil').value=-0.75;$('#sAge').value=34;
    SIMT.forEach(function(t){S[t[0]]=0;});M={soft:1,rgp:1,scl:1};
    $$('#simToggles .tg').forEach(function(b){b.classList.remove('on');});$$('#simMat .tg').forEach(function(b){b.classList.add('on');});runSim();};
  $('#simKera').onclick=function(){$('#sK').value=58;$('#sEsf').value=-9;$('#sCil').value=-4.5;$('#sAge').value=27;
    SIMT.forEach(function(t){S[t[0]]=0;});S.ectasia=1;
    $$('#simToggles .tg').forEach(function(b){b.classList.toggle('on',b.getAttribute('data-t')==='ectasia');});runSim();};
  $('#simPedia').onclick=function(){$('#sK').value=52;$('#sEsf').value=14;$('#sCil').value=0;$('#sAge').value=1;
    SIMT.forEach(function(t){S[t[0]]=0;});S.pedia=1;S.uv=1;
    $$('#simToggles .tg').forEach(function(b){var id=b.getAttribute('data-t');b.classList.toggle('on',id==='pedia'||id==='uv');});runSim();};
  runSim();
});

/* ================= referências ================= */
function refHTML(list,start){
  return list.map(function(r,i){
    return '<a class="rf2" href="'+r[1]+'" target="_blank" rel="noopener"><span class="n">'+String(start+i).padStart(2,'0')+'.</span><span>'+r[0]+'<span class="u">'+r[1]+'</span></span></a>';}).join('');
}
safe(function(){
  $('#refs1').innerHTML=refHTML(REFS.slice(0,39),1);
  $('#refs2').innerHTML=refHTML(REFS.slice(39),40);
});

/* ================= NAVEGAÇÃO ================= */
var slides=$$('.slide'),cur=0;
function fillSlide(s){
  if(!s)return;
  $$('.fl,.rf',s).forEach(function(f){var w=f.getAttribute('data-w');if(w){f.style.width='0';}});
  void s.offsetWidth;
  $$('.fl,.rf',s).forEach(function(f){var w=f.getAttribute('data-w');if(w)f.style.width=w+'%';});
}
function countSlide(s){
  if(!s)return;
  $$('[data-count]',s).forEach(function(el){
    if(el.getAttribute('data-done'))return;el.setAttribute('data-done','1');
    var t=parseFloat(el.getAttribute('data-count')),sfx=el.getAttribute('data-suffix')||'';
    if(el.getAttribute('data-plain')){el.textContent=String(t);return;}
    var t0=performance.now();
    (function st(now){var p=Math.min(1,(now-t0)/1300),e=1-Math.pow(1-p,3),v=Math.round(t*e);
      el.textContent=(v>=1000?v.toLocaleString('pt-BR'):v)+sfx;if(p<1)requestAnimationFrame(st);})(t0);
  });
}
function goTo(i){
  i=Math.max(0,Math.min(slides.length-1,i));
  slides[cur].classList.remove('active');
  slides[cur].scrollTop=0;
  cur=i;
  var s=slides[cur];
  s.classList.add('active');s.scrollTop=0;
  $('#counter').innerHTML='<b>'+(cur+1)+'</b> / '+slides.length;
  $('#secLabel').textContent=s.getAttribute('data-sec')||'—';
  $('#prog').style.width=((cur)/(slides.length-1)*100)+'%';
  $$('#dots i').forEach(function(d,j){d.classList.toggle('on',j===cur);});
  $$('#ovGrid .ovc').forEach(function(c,j){c.classList.toggle('on',j===cur);});
  $('#bPrev').disabled=(cur===0);$('#bNext').disabled=(cur===slides.length-1);
  setTimeout(function(){fillSlide(s);countSlide(s);tipBind(s);},60);
  if(history.replaceState)history.replaceState(null,'','#'+(cur+1));
}
function next(){goTo(cur+1);} function prev(){goTo(cur-1);}
$('#bNext').onclick=next;$('#bPrev').onclick=prev;

/* dots + overview */
safe(function(){
  $('#dots').innerHTML=slides.map(function(s,i){
    return '<i data-i="'+i+'" title="'+(i+1)+'. '+esc(s.getAttribute('data-t')||'')+'"></i>';}).join('');
  $$('#dots i').forEach(function(d){d.onclick=function(){goTo(parseInt(this.getAttribute('data-i'),10));};});
  $('#ovGrid').innerHTML=slides.map(function(s,i){
    return '<button class="ovc" data-i="'+i+'"><div class="n">SLIDE '+String(i+1).padStart(2,'0')+'</div>'+
     '<div class="t">'+esc(s.getAttribute('data-t')||'')+'</div><div class="s">'+esc(s.getAttribute('data-sec')||'')+'</div></button>';}).join('');
  $$('#ovGrid .ovc').forEach(function(c){c.onclick=function(){goTo(parseInt(this.getAttribute('data-i'),10));toggleOv(false);};});
});
function toggleOv(v){
  var o=$('#ov');
  if(v===undefined)v=!o.classList.contains('show');
  o.classList.toggle('show',v);
}
$('#bOv').onclick=function(){toggleOv();};
$('#ovClose').onclick=function(){toggleOv(false);};
$('#bFs').onclick=function(){
  if(!document.fullscreenElement){(document.documentElement.requestFullscreen||function(){}).call(document.documentElement);}
  else if(document.exitFullscreen)document.exitFullscreen();
};

/* teclado */
document.addEventListener('keydown',function(e){
  if($('#mbg').classList.contains('show')){if(e.key==='Escape')closeM();return;}
  if($('#ov').classList.contains('show')){if(e.key==='Escape')toggleOv(false);return;}
  var tag=(e.target.tagName||'').toLowerCase();
  if(tag==='input'||tag==='textarea')return;
  switch(e.key){
    case 'ArrowRight':case 'PageDown':case ' ':e.preventDefault();next();break;
    case 'ArrowLeft':case 'PageUp':e.preventDefault();prev();break;
    case 'Home':e.preventDefault();goTo(0);break;
    case 'End':e.preventDefault();goTo(slides.length-1);break;
    case 'o':case 'O':toggleOv();break;
    case 'f':case 'F':$('#bFs').click();break;
    case 'Escape':toggleOv(false);break;
  }
});

/* roda do rato (apenas quando o slide não tem scroll próprio) */
var wheelLock=false;
document.addEventListener('wheel',function(e){
  if($('#mbg').classList.contains('show')||$('#ov').classList.contains('show'))return;
  var s=slides[cur];
  if(s.scrollHeight>s.clientHeight+8)return;
  if(wheelLock)return;
  if(Math.abs(e.deltaY)<24)return;
  wheelLock=true;setTimeout(function(){wheelLock=false;},620);
  if(e.deltaY>0)next();else prev();
},{passive:true});

/* toque */
var tx=0,ty=0;
document.addEventListener('touchstart',function(e){tx=e.touches[0].clientX;ty=e.touches[0].clientY;},{passive:true});
document.addEventListener('touchend',function(e){
  if($('#mbg').classList.contains('show'))return;
  var dx=e.changedTouches[0].clientX-tx,dy=e.changedTouches[0].clientY-ty;
  if(Math.abs(dx)>70&&Math.abs(dx)>Math.abs(dy)*1.4){if(dx<0)next();else prev();}
},{passive:true});

/* hash inicial + init */
safe(function(){
  var h=parseInt((location.hash||'').replace('#',''),10);
  goTo(isNaN(h)?0:Math.max(0,Math.min(slides.length-1,h-1)));
  tipBind(document);
  setTimeout(function(){$('#hint').classList.add('hide');},7000);
});
</script>
