<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Solótica — Apresentação do Dossiê Técnico</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/sora@5.2.5/latin-600.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/sora@5.2.5/latin-700.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/sora@5.2.5/latin-800.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.2.5/latin-400.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.2.5/latin-500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.2.5/latin-600.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/inter@5.2.5/latin-700.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.2.5/latin-500.css">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource/jetbrains-mono@5.2.5/latin-700.css">
<style>
:root{
 --bg:#04060c;--bg2:#0a1020;--panel:rgba(255,255,255,.06);--panel2:rgba(255,255,255,.10);
 --line:rgba(255,255,255,.17);--line2:rgba(255,255,255,.34);
 --txt:#fff;--mut:#dbe3f0;--mut2:#b3bfd2;--dim:#93a0b6;
 --aqua:#3ff0d4;--blue:#6cbcff;--amber:#ffbb52;--rose:#ff85ad;--violet:#b79bff;--lime:#bdf06f;
 --grad:linear-gradient(120deg,#3ff0d4,#6cbcff 45%,#b79bff);
}
*{box-sizing:border-box;margin:0;padding:0}
html,body{height:100%}
body{background:var(--bg);color:var(--txt);font-family:'Inter',system-ui,sans-serif;font-size:16.5px;line-height:1.68;overflow:hidden;-webkit-font-smoothing:antialiased}
body::before{content:'';position:fixed;inset:0;z-index:0;pointer-events:none;
 background:radial-gradient(1000px 700px at 80% -10%,rgba(108,188,255,.20),transparent 60%),
 radial-gradient(820px 600px at 5% 15%,rgba(63,240,212,.14),transparent 60%),
 radial-gradient(1100px 800px at 50% 112%,rgba(183,155,255,.14),transparent 62%)}
h1,h2,h3,h4,h5,h6{font-family:'Sora','Inter',sans-serif;letter-spacing:-.02em;line-height:1.16;color:#fff}
.mono{font-family:'JetBrains Mono',ui-monospace,monospace;font-weight:500}
b,strong{color:#fff;font-weight:700}
::selection{background:rgba(63,240,212,.35)}
::-webkit-scrollbar{width:10px;height:10px}
::-webkit-scrollbar-track{background:rgba(255,255,255,.03)}
::-webkit-scrollbar-thumb{background:#2a3a5c;border-radius:8px;border:2px solid transparent;background-clip:padding-box}
::-webkit-scrollbar-thumb:hover{background:#3d5480;background-clip:padding-box}

/* ===== DECK ===== */
#deck{position:relative;z-index:2;height:100vh;height:100dvh;width:100%}
.slide{display:none;height:100vh;height:100dvh;width:100%;overflow-y:auto;overflow-x:hidden;padding:74px 30px 96px;scroll-behavior:smooth}
.slide.active{display:block}
.slide.active>.inner{animation:up .55s cubic-bezier(.2,.75,.3,1) both}
@keyframes up{from{opacity:0;transform:translateY(26px)}to{opacity:1;transform:none}}
.inner{max-width:1320px;margin:0 auto;min-height:100%;display:flex;flex-direction:column;justify-content:center;gap:0}
.inner.top{justify-content:flex-start}
.eyebrow{display:inline-flex;align-items:center;gap:10px;font-size:11.5px;font-weight:800;letter-spacing:.2em;text-transform:uppercase;color:var(--aqua);margin-bottom:14px}
.eyebrow::before{content:'';width:28px;height:2px;background:linear-gradient(90deg,var(--aqua),transparent)}
h2.st{font-size:clamp(27px,3.7vw,46px);font-weight:800;margin-bottom:14px}
h3.ss{font-size:clamp(19px,2vw,26px);font-weight:700;margin-bottom:10px}
.lead{color:var(--mut);font-size:clamp(14.5px,1.15vw,17.5px);max-width:1000px}
.grad{background:var(--grad);-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.card{background:var(--panel);border:1px solid var(--line);border-radius:16px}
.pad{padding:24px}
.g2{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}
.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
.mt{margin-top:22px}
.flag{display:inline-block;font-size:11.5px;font-weight:700;padding:6px 12px;border-radius:8px;background:var(--panel2);border:1px solid var(--line);color:var(--mut);margin:0 6px 6px 0}
ul.tick{list-style:none;display:flex;flex-direction:column;gap:9px}
ul.tick li{font-size:14.4px;color:var(--mut);padding-left:24px;position:relative;line-height:1.6}
ul.tick li::before{content:'';position:absolute;left:0;top:8px;width:10px;height:10px;border-radius:3px;background:var(--aqua)}
ul.tick.a li::before{background:var(--amber)}
ul.tick.r li::before{background:var(--rose)}
ul.tick.v li::before{background:var(--violet)}

/* ===== CHROME ===== */
#prog{position:fixed;top:0;left:0;height:3px;width:0;z-index:999;background:var(--grad);box-shadow:0 0 16px rgba(63,240,212,.7);transition:width .35s}
#topbar{position:fixed;top:0;left:0;right:0;z-index:900;height:56px;display:flex;align-items:center;gap:14px;padding:0 20px;
 background:rgba(4,6,12,.82);backdrop-filter:blur(18px);border-bottom:1px solid var(--line)}
#topbar .brand{display:flex;align-items:center;gap:10px}
#topbar .brand svg{width:28px;height:28px}
#topbar .brand b{font-family:'Sora';font-size:16px;font-weight:800;letter-spacing:-.02em}
#topbar .brand span{font-size:9px;letter-spacing:.2em;color:var(--mut2);text-transform:uppercase;display:block;margin-top:-4px;font-weight:700}
#secLabel{font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--aqua);margin-left:8px;
 padding:5px 12px;border-radius:8px;background:rgba(63,240,212,.1);border:1px solid rgba(63,240,212,.3)}
#topbtns{margin-left:auto;display:flex;gap:8px;align-items:center}
.tbtn{width:36px;height:34px;border-radius:10px;background:var(--panel);border:1px solid var(--line);color:var(--mut);cursor:pointer;
 font-size:15px;display:grid;place-items:center;transition:.2s;font-family:'Inter'}
.tbtn:hover{color:#fff;border-color:var(--aqua);background:var(--panel2)}
#counter{font-family:'JetBrains Mono';font-size:12.5px;font-weight:700;color:var(--mut2);min-width:66px;text-align:center;letter-spacing:.04em}
#counter b{color:#fff;font-size:14.5px}

#botbar{position:fixed;bottom:0;left:0;right:0;z-index:900;height:60px;display:flex;align-items:center;justify-content:center;gap:14px;
 background:rgba(4,6,12,.86);backdrop-filter:blur(18px);border-top:1px solid var(--line)}
.navb{height:40px;padding:0 20px;border-radius:11px;background:var(--panel);border:1px solid var(--line);color:#fff;cursor:pointer;
 font-size:13.5px;font-weight:700;font-family:'Inter';display:flex;align-items:center;gap:9px;transition:.2s}
.navb:hover:not(:disabled){background:var(--grad);color:#04060c;border-color:transparent}
.navb:disabled{opacity:.32;cursor:not-allowed}
#dots{display:flex;gap:5px;align-items:center;max-width:46vw;overflow:hidden}
#dots i{width:7px;height:7px;border-radius:50%;background:rgba(255,255,255,.22);cursor:pointer;transition:.25s;flex-shrink:0}
#dots i:hover{background:var(--mut2);transform:scale(1.35)}
#dots i.on{background:var(--aqua);width:22px;border-radius:5px;box-shadow:0 0 10px rgba(63,240,212,.7)}
#hint{position:fixed;bottom:70px;left:50%;transform:translateX(-50%);z-index:880;font-size:11.5px;color:var(--dim);
 background:rgba(4,6,12,.8);border:1px solid var(--line);padding:6px 14px;border-radius:99px;backdrop-filter:blur(8px);transition:.5s;pointer-events:none}
#hint.hide{opacity:0}
kbd{font-family:'JetBrains Mono';font-size:10.5px;background:rgba(255,255,255,.1);border:1px solid var(--line);border-radius:5px;padding:1px 6px;color:var(--mut);font-weight:700}

/* overview */
#ov{position:fixed;inset:0;z-index:960;background:rgba(3,5,10,.96);backdrop-filter:blur(14px);display:none;overflow-y:auto;padding:80px 30px 40px}
#ov.show{display:block}
#ovGrid{max-width:1400px;margin:0 auto;display:grid;grid-template-columns:repeat(auto-fill,minmax(214px,1fr));gap:14px}
.ovc{padding:16px;border-radius:13px;background:var(--panel);border:1px solid var(--line);cursor:pointer;transition:.22s;text-align:left}
.ovc:hover{transform:translateY(-4px);border-color:var(--aqua);background:var(--panel2)}
.ovc.on{border-color:var(--aqua);background:rgba(63,240,212,.12)}
.ovc .n{font-family:'JetBrains Mono';font-size:11px;font-weight:700;color:var(--aqua);margin-bottom:6px}
.ovc .t{font-size:13.2px;font-weight:600;color:#fff;line-height:1.4}
.ovc .s{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut2);margin-top:7px;font-weight:700}
#ovClose{position:fixed;top:20px;right:24px;z-index:970}
#ovTitle{max-width:1400px;margin:0 auto 24px;font-size:22px;font-weight:800}

/* tooltip */
#tip{position:fixed;z-index:1000;pointer-events:none;opacity:0;transform:translateY(6px);transition:opacity .16s,transform .16s;max-width:340px;
 background:rgba(8,13,24,.98);border:1px solid var(--line2);border-radius:12px;padding:12px 15px;box-shadow:0 20px 48px -14px rgba(0,0,0,.95);font-size:13.2px;line-height:1.6;color:var(--mut)}
#tip.show{opacity:1;transform:none}
#tip .tt{font-family:'Sora';font-weight:700;font-size:13.6px;color:#fff;display:block;margin-bottom:5px}
#tip .tv{font-family:'JetBrains Mono';font-weight:700;color:var(--aqua)}

/* cover */
.cover{align-items:center;text-align:center;gap:0}
.cover .logo{width:96px;height:96px;margin-bottom:26px;animation:fl 4s ease-in-out infinite}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-11px)}}
.cover h1{font-size:clamp(38px,7vw,86px);font-weight:800;line-height:1.03;margin-bottom:18px}
.cover .sub{font-size:clamp(14px,1.5vw,19px);color:var(--mut);max-width:820px;margin:0 auto 30px}
.cover .meta{display:flex;gap:10px;flex-wrap:wrap;justify-content:center;margin-top:8px}
.ring{position:absolute;border-radius:50%;border:1px solid rgba(255,255,255,.07);pointer-events:none}

/* KPI */
.kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:14px}
.kpi{padding:24px 14px;text-align:center;border-radius:15px;background:var(--panel);border:1px solid var(--line);position:relative;overflow:hidden;transition:.3s}
.kpi:hover{transform:translateY(-4px);border-color:var(--aqua)}
.kpi::after{content:'';position:absolute;top:0;left:0;right:0;height:3px;background:var(--grad);opacity:.85}
.kpi .n{font-family:'Sora';font-size:clamp(22px,2.6vw,36px);font-weight:800;line-height:1;display:block}
.kpi .l{font-size:10.8px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut2);margin-top:11px;display:block;line-height:1.45;font-weight:700}

/* timeline */
.tl{display:grid;grid-template-columns:repeat(auto-fit,minmax(232px,1fr));gap:14px}
.tlc{padding:20px;border-radius:15px;background:var(--panel);border:1px solid var(--line);cursor:pointer;transition:.28s;position:relative;overflow:hidden}
.tlc::before{content:'';position:absolute;left:0;top:0;bottom:0;width:3px;background:var(--grad);opacity:.5;transition:.3s}
.tlc:hover{transform:translateY(-4px);border-color:var(--line2);background:var(--panel2)}
.tlc:hover::before,.tlc.open::before{opacity:1;width:4px}
.tlc .yr{font-family:'Sora';font-weight:800;font-size:15px;color:var(--aqua);margin-bottom:6px}
.tlc h4{font-size:15.5px;font-weight:700;margin-bottom:8px;line-height:1.3}
.tlc .bd{max-height:0;overflow:hidden;transition:max-height .5s cubic-bezier(.2,.7,.3,1)}
.tlc.open .bd{max-height:760px}
.tlc .bd p{font-size:13.4px;color:var(--mut);line-height:1.62}
.tlc .mo{font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut2);font-weight:700;margin-top:8px}
.tlc.open .mo{color:var(--aqua)}

/* tables */
.tw{overflow:auto;border-radius:14px;border:1px solid var(--line);background:var(--panel);max-height:62vh}
table.dt{width:100%;border-collapse:collapse;font-size:12.8px;min-width:900px}
table.dt th{position:sticky;top:0;z-index:2;text-align:left;padding:12px 13px;background:#0c1424;border-bottom:1px solid var(--line2);
 font-size:10.2px;letter-spacing:.1em;text-transform:uppercase;color:var(--mut2);font-weight:800;white-space:nowrap}
table.dt td{padding:12px 13px;border-bottom:1px solid rgba(255,255,255,.08);color:var(--mut);line-height:1.55;vertical-align:top}
table.dt tr:hover td{background:rgba(255,255,255,.045)}
table.dt td.nm{color:#fff;font-weight:700;font-size:13.2px;white-space:nowrap}
table.dt td.ac{color:var(--aqua);font-family:'JetBrains Mono';font-weight:700;font-size:12.2px}
table.dt td.na{color:var(--dim);font-style:italic}
.pill{display:inline-block;font-size:10px;font-weight:800;letter-spacing:.09em;text-transform:uppercase;padding:3px 9px;border-radius:6px;white-space:nowrap}

/* charts */
.ch{padding:22px;border-radius:16px;background:var(--panel);border:1px solid var(--line)}
.ch h4{font-size:16.5px;margin-bottom:5px}
.ch .nt{font-size:12.6px;color:var(--mut2);margin-bottom:16px;line-height:1.55;font-weight:500}
.hint{display:inline-flex;align-items:center;gap:7px;font-size:11px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;
 color:var(--aqua);background:rgba(63,240,212,.11);border:1px solid rgba(63,240,212,.32);padding:5px 11px;border-radius:8px;margin-bottom:14px}
.mini{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:14px}
.mb{font-size:11.6px;font-weight:700;padding:7px 13px;border-radius:9px;background:rgba(255,255,255,.07);border:1px solid var(--line);
 color:var(--mut);cursor:pointer;transition:.2s;font-family:'Inter'}
.mb:hover{color:#fff;border-color:var(--line2)}
.mb.on{background:rgba(63,240,212,.18);border-color:rgba(63,240,212,.55);color:var(--aqua)}
.ib{padding:8px 11px;border-radius:11px;cursor:pointer;transition:.2s;border:1px solid transparent;margin-bottom:4px}
.ib:hover,.ib.sel{background:rgba(255,255,255,.08);border-color:var(--line2)}
.ib.sel{border-color:var(--aqua);background:rgba(63,240,212,.1)}
.ib .bl{display:flex;justify-content:space-between;align-items:baseline;gap:12px;font-size:13px;margin-bottom:7px}
.ib .bl b{font-weight:600;color:#fff;line-height:1.35}
.ib .bl span{font-family:'JetBrains Mono';font-size:13px;font-weight:700;white-space:nowrap}
.ib .tr{height:12px;border-radius:7px;background:rgba(255,255,255,.1);overflow:hidden}
.ib .fl{height:100%;width:0;border-radius:7px;transition:width 1.1s cubic-bezier(.2,.8,.25),filter .2s}
.ib:hover .fl{filter:brightness(1.28)}
.det{margin-top:16px;padding:18px;border-radius:13px;background:rgba(255,255,255,.055);border:1px solid var(--line);border-left:3px solid var(--aqua)}
.det h5{font-size:15px;margin-bottom:7px;font-family:'Sora'}
.det p{font-size:13.4px;color:var(--mut);line-height:1.65;margin-bottom:10px}
.lnk{display:flex;flex-wrap:wrap;gap:7px}
.rr{display:grid;grid-template-columns:206px 1fr;gap:13px;align-items:center;padding:5px 8px;border-radius:10px;cursor:pointer;transition:.2s;border:1px solid transparent;margin-bottom:4px}
.rr:hover,.rr.sel{background:rgba(255,255,255,.08);border-color:var(--line2)}
.rr.sel{border-color:var(--aqua)}
.rr .rn{font-size:12.4px;color:var(--mut);text-align:right;line-height:1.35;font-weight:500}
.rr:hover .rn,.rr.sel .rn{color:#fff}
.rt{position:relative;height:24px;background:rgba(255,255,255,.06);border-radius:7px}
.rt .z{position:absolute;top:-5px;bottom:-5px;width:1.5px;background:rgba(255,255,255,.45)}
.rf{position:absolute;top:4px;bottom:4px;border-radius:6px;min-width:6px;width:0;transition:width 1s cubic-bezier(.2,.8,.25),filter .2s}
.rr:hover .rf{filter:brightness(1.3)}
.rf span{position:absolute;right:9px;top:50%;transform:translateY(-50%);font-size:10.4px;font-family:'JetBrains Mono';font-weight:700;color:rgba(0,0,0,.85);white-space:nowrap}
.rf.out span{color:#fff;right:auto;left:calc(100% + 8px)}
.ax{display:flex;justify-content:space-between;font-size:10.6px;color:var(--mut2);font-family:'JetBrains Mono';font-weight:700;margin:18px 0 8px}
.dnw{display:flex;align-items:center;gap:24px;flex-wrap:wrap;justify-content:center}
.lg{display:flex;flex-direction:column;gap:8px}
.lg div{display:flex;align-items:center;gap:10px;font-size:13px;color:var(--mut);cursor:pointer;padding:4px 8px;border-radius:8px;transition:.2s;font-weight:500}
.lg div:hover,.lg div.on{background:rgba(255,255,255,.09);color:#fff}
.lg i{width:12px;height:12px;border-radius:3px;flex-shrink:0}
.lg b{margin-left:auto;font-family:'JetBrains Mono';color:#fff;font-size:12.8px}
.wl{display:flex;align-items:center;gap:20px;margin-top:16px;padding:16px;border-radius:13px;background:rgba(255,255,255,.05);border:1px solid var(--line)}
.wl svg{width:104px;height:104px;flex-shrink:0}
.wl .big{font-family:'Sora';font-size:31px;font-weight:800;color:var(--blue);line-height:1;margin-bottom:5px}
.wl h5{font-size:14.5px;margin-bottom:4px}
.wl p{font-size:12.8px;color:var(--mut);line-height:1.55}
.es{display:flex;align-items:center;gap:18px;margin-top:16px;padding:16px;border-radius:13px;background:rgba(255,255,255,.05);border:1px solid var(--line)}
.es svg{width:124px;height:124px;flex-shrink:0}
.es .big{font-family:'Sora';font-size:30px;font-weight:800;color:var(--aqua);line-height:1.1}
.es p{font-size:12.8px;color:var(--mut);line-height:1.55;margin-top:5px}

/* sliders / simulador */
.sl{margin-bottom:20px}
.sl .sh{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:9px;gap:12px}
.sl .sh label{font-size:13px;font-weight:700;color:#fff}
.sl .sh output{font-family:'JetBrains Mono';font-weight:700;font-size:14.5px;color:var(--aqua);background:rgba(63,240,212,.12);
 border:1px solid rgba(63,240,212,.32);padding:3px 11px;border-radius:8px;min-width:92px;text-align:center}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:8px;border-radius:6px;
 background:linear-gradient(90deg,var(--aqua) var(--p,50%),rgba(255,255,255,.14) var(--p,50%));outline:none;cursor:pointer}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:#fff;border:4px solid var(--aqua);cursor:pointer;box-shadow:0 3px 12px rgba(0,0,0,.6)}
input[type=range]::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:#fff;border:4px solid var(--aqua);cursor:pointer}
.tgs{display:flex;flex-wrap:wrap;gap:7px}
.tg{font-size:12.2px;font-weight:700;padding:8px 13px;border-radius:10px;background:rgba(255,255,255,.07);border:1px solid var(--line);
 color:var(--mut);cursor:pointer;transition:.2s;font-family:'Inter';display:flex;align-items:center;gap:7px}
.tg:hover{color:#fff;border-color:var(--line2)}
.tg.on{background:rgba(183,155,255,.2);border-color:rgba(183,155,255,.6);color:#ddceff}
.tg .bx{width:13px;height:13px;border-radius:4px;border:2px solid currentColor;display:grid;place-items:center;font-size:9px;line-height:1}
.tg.on .bx::after{content:'✓';font-weight:900}
.sh2{font-size:11.5px;letter-spacing:.15em;text-transform:uppercase;color:var(--mut2);font-weight:800;margin:20px 0 11px}
.rec{padding:16px;border-radius:14px;border:1px solid var(--line);background:rgba(255,255,255,.05);margin-bottom:11px;transition:.25s;cursor:pointer}
.rec:hover{transform:translateX(5px);border-color:var(--line2);background:rgba(255,255,255,.08)}
.rec .rh{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:7px}
.rec h5{font-size:15px;font-family:'Sora';font-weight:700}
.rec .mt2{font-family:'Sora';font-weight:800;font-size:18px;white-space:nowrap}
.rec .mtr{height:6px;border-radius:4px;background:rgba(255,255,255,.13);overflow:hidden;margin-bottom:9px}
.rec .mtr i{display:block;height:100%;border-radius:4px}
.rec p{font-size:12.8px;color:var(--mut);line-height:1.55}
.rec .why{display:flex;flex-wrap:wrap;gap:6px;margin-top:9px}
