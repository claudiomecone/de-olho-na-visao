/* ================= tooltip ================= */
var tipEl=$('#tip');
function tipBind(root){
  $$('[data-tip]',root||document).forEach(function(el){
    if(el.getAttribute('data-tb'))return; el.setAttribute('data-tb','1');
    el.addEventListener('mouseenter',function(e){tipEl.innerHTML=this.getAttribute('data-tip');tipEl.classList.add('show');tipMove(e);});
    el.addEventListener('mouseleave',function(){tipEl.classList.remove('show');});
  });
}
function tipMove(e){
  if(!tipEl.classList.contains('show'))return;
  var w=tipEl.offsetWidth,h=tipEl.offsetHeight,x=e.clientX+18,y=e.clientY+18;
  if(x+w>innerWidth-12)x=e.clientX-w-18;
  if(y+h>innerHeight-12)y=e.clientY-h-18;
  tipEl.style.left=Math.max(8,x)+'px';tipEl.style.top=Math.max(8,y)+'px';
}
document.addEventListener('mousemove',function(e){if(tipEl.classList.contains('show'))tipMove(e);},{passive:true});

